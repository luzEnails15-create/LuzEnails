rules_version = '2';

// Reglas de seguridad para el sistema de citas.
//
// - "services" y "config": cualquiera puede leer (para mostrar la página
//   pública), pero solo un administrador autenticado puede escribir.
// - "slots": guarda SOLO fecha/hora/duración (sin datos del cliente).
//   Cualquiera puede leerlo (para calcular disponibilidad) y crear uno
//   nuevo (para reservar), pero solo el administrador puede editarlo o
//   borrarlo (por ejemplo, al cancelar una cita).
// - "appointments": guarda los datos completos de la cita, incluido el
//   nombre y teléfono del cliente.
//   * Cualquiera puede CREAR una cita nueva (necesario para reservar sin
//     iniciar sesión).
//   * Cualquiera puede LEER una cita individual si ya conoce su ID
//     ("allow get"), porque ese ID actúa como código secreto de
//     cancelación que solo recibe el propio cliente al reservar. Nadie
//     puede LISTAR todas las citas ("allow list") sin ser administrador,
//     así que un desconocido no puede "adivinar" o enumerar las citas de
//     otras personas — solo quien tiene el código exacto puede ver esa
//     cita puntual.
//   * Cualquiera puede ACTUALIZAR una cita solo para cancelarla (cambiar
//     únicamente el campo "status" a "cancelled"), lo demás sigue
//     protegido y solo lo puede modificar el administrador autenticado.
service cloud.firestore {
  match /databases/{database}/documents {

    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /slots/{slotId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null;
      // Se permite borrar sin sesión SOLO para liberar el horario cuando
      // un cliente cancela su propia cita desde la página pública (los
      // slots no contienen nombre ni teléfono, solo fecha/hora/duración).
      allow delete: if true;
    }

    match /appointments/{appointmentId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if true;
      allow update: if request.auth != null || isPublicCancel();
      allow delete: if request.auth != null;
    }

    function isPublicCancel() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled'
        && resource.data.status != 'cancelled';
    }
  }
}
